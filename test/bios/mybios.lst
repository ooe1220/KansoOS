     1                                  [bits 16]
     2                                  
     3                                  ; ===============================
     4                                  ; BIOS本体
     5                                  ; nasm -f bin mybios.asm -o mybios.bin
     6                                  ; ===============================
     7                                  org 0x0000 ; BIOSは0xF0000-0xFFFFFの64KB(メモリ1MBの一番高い領域)
     8                                  
     9                                  bios_start:
    10                                  
    11 00000000 FA                          cli
    12 00000001 B800F0                      mov ax, 0xF000
    13 00000004 8ED8                        mov ds, ax
    14 00000006 8EC0                        mov es, ax
    15 00000008 B80000                      mov ax, 0x0000
    16 0000000B 8ED0                        mov ss, ax
    17 0000000D BC007C                      mov sp, 0x7C00
    18 00000010 FC                          cld
    19                                      
    20                                      ; A20
    21 00000011 E492                        in   al, 0x92
    22 00000013 0C02                        or   al, 0x02
    23 00000015 24FE                        and  al, 0xFE
    24 00000017 E692                        out  0x92, al
    25                                      
    26 00000019 BAE900                      mov dx, 0x00E9
    27 0000001C B031                        mov al, '1'
    28 0000001E EE                          out dx, al
    29                                      
    30                                  
    31                                      ; ----------------------------------------
    32                                      ; 2. VGA 基本初期化 (ブランキング解除など)
    33                                      ; ----------------------------------------
    34                                      ; 属性コントローラのブランキング解除 (0x3C0)
    35 0000001F BAC003                      mov dx, 0x3C0
    36 00000022 B020                        mov al, 0x20
    37 00000024 EE                          out dx, al
    38                                  
    39                                      ; ----------------------------------------
    40                                      ; 3. Bochs VBE (DISPI) 初期化
    41                                      ; 仕様: Disable -> 設定 -> Enable(LFB)
    42                                      ; ----------------------------------------
    43                                      ; 3-1. Disable (変更前に必須)
    44 00000025 BACE01                      mov dx, 0x01CE
    45 00000028 B80400                      mov ax, 0x0004     ; VBE_DISPI_INDEX_ENABLE
    46 0000002B EF                          out dx, ax
    47 0000002C BACF01                      mov dx, 0x01CF
    48 0000002F B80000                      mov ax, 0x0000     ; VBE_DISPI_DISABLED
    49 00000032 EF                          out dx, ax
    50                                  
    51                                      ; 3-2. XRES = 800
    52 00000033 BACE01                      mov dx, 0x01CE
    53 00000036 B80100                      mov ax, 0x0001     ; VBE_DISPI_INDEX_XRES
    54 00000039 EF                          out dx, ax
    55 0000003A BACF01                      mov dx, 0x01CF
    56 0000003D B82003                      mov ax, 800
    57 00000040 EF                          out dx, ax
    58                                  
    59                                      ; 3-3. YRES = 600
    60 00000041 BACE01                      mov dx, 0x01CE
    61 00000044 B80200                      mov ax, 0x0002     ; VBE_DISPI_INDEX_YRES
    62 00000047 EF                          out dx, ax
    63 00000048 BACF01                      mov dx, 0x01CF
    64 0000004B B85802                      mov ax, 600
    65 0000004E EF                          out dx, ax
    66                                  
    67                                      ; 3-4. BPP = 16
    68 0000004F BACE01                      mov dx, 0x01CE
    69 00000052 B80300                      mov ax, 0x0003     ; VBE_DISPI_INDEX_BPP
    70 00000055 EF                          out dx, ax
    71 00000056 BACF01                      mov dx, 0x01CF
    72 00000059 B81000                      mov ax, 16
    73 0000005C EF                          out dx, ax
    74                                  
    75                                      ; 3-5. Enable (LFB有効 | 通常有効)
    76                                      ; 0x01 (ENABLED) + 0x40 (LFB_ENABLED) = 0x41
    77 0000005D BACE01                      mov dx, 0x01CE
    78 00000060 B80400                      mov ax, 0x0004     ; VBE_DISPI_INDEX_ENABLE
    79 00000063 EF                          out dx, ax
    80 00000064 BACF01                      mov dx, 0x01CF
    81                                      ;mov ax, 0x0041     ; VBE_DISPI_ENABLED | VBE_DISPI_LFB_ENABLED
    82 00000067 B8C100                      mov ax, 0x00C1
    83 0000006A EF                          out dx, ax
    84                                      
    85                                      ; GDT読み込み
    86 0000006B 0F0116[A600]                lgdt [gdt_descriptor]
    87                                      
    88 00000070 BAE900                      mov dx, 0x00E9
    89 00000073 B032                        mov al, '2'
    90 00000075 EE                          out dx, al
    91                                  
    92                                      ; 32bitモード有効化
    93 00000076 0F20C0                      mov eax, cr0
    94 00000079 6683C801                    or eax, 1
    95 0000007D 0F22C0                      mov cr0, eax
    96                                      
    97 00000080 BAE900                      mov dx, 0x00E9
    98 00000083 B033                        mov al, '3'
    99 00000085 EE                          out dx, al
   100                                      
   101                                      ; 32ビットコードへ跳ぶ
   102                                      ;jmp 0x08:pm_start
   103 00000086 66EA[AC000F00]0800          jmp dword 0x08:(0xF0000 + pm_start)
   104                                      
   105                                  gdt_start:
   106 0000008E 0000000000000000            dq 0x0000000000000000            ; NULL
   107                                  
   108                                  gdt_code:
   109 00000096 FFFF                        dw 0xFFFF                        ; limit 0-15
   110 00000098 0000                        dw 0x0000                        ; base 0-15
   111 0000009A 00                          db 0x00                          ; base 16-23
   112 0000009B 9A                          db 0x9A                          ; code segment
   113 0000009C CF                          db 0xCF                          ; flags
   114 0000009D 00                          db 0x00                          ; base 24-31
   115                                  
   116                                  gdt_data:
   117 0000009E FFFF                        dw 0xFFFF
   118 000000A0 0000                        dw 0x0000
   119 000000A2 00                          db 0x00
   120 000000A3 92                          db 0x92                          ; data segment
   121 000000A4 CF                          db 0xCF
   122 000000A5 00                          db 0x00
   123                                  gdt_end:
   124                                  
   125                                  gdt_descriptor:
   126 000000A6 1700                        dw gdt_end - gdt_start - 1
   127                                      ;dd gdt_start
   128 000000A8 8E000F00                    dd 0xF0000 + (gdt_start - $$) 
   129                                  
   130                                  [bits 32]
   131                                  pm_start:
   132                                      ; データセグメント設定（フラット）
   133 000000AC 66B81000                    mov ax, 0x10
   134 000000B0 8ED8                        mov ds, ax
   135 000000B2 8EC0                        mov es, ax
   136 000000B4 8EE0                        mov fs, ax
   137 000000B6 8EE8                        mov gs, ax
   138 000000B8 8ED0                        mov ss, ax
   139 000000BA BC00FC0900                  mov esp, 0x9FC00
   140                                      
   141 000000BF 66BAE900                    mov dx, 0x00E9
   142 000000C3 B034                        mov al, '4'
   143 000000C5 EE                          out dx, al
   144                                      
   145                                      ;;;;;;;;;;;;;;;
   146                                      
   147                                          ; Enableレジスタを読み戻す
   148 000000C6 66BACE01                    mov dx, 0x01CE
   149 000000CA 66B80400                    mov ax, 0x0004
   150 000000CE 66EF                        out dx, ax
   151                                  
   152 000000D0 66BACF01                    mov dx, 0x01CF
   153 000000D4 66ED                        in  ax, dx
   154                                  
   155                                      ; bit 0: VBE enabled
   156 000000D6 66A90100                    test ax, 0x0001
   157 000000DA 740F                        jz .vbe_not_enabled
   158                                  
   159                                      ; bit 6: LFB enabled
   160 000000DC 66A94000                    test ax, 0x0040
   161 000000E0 7412                        jz .lfb_not_enabled
   162                                  
   163 000000E2 66BAE900                    mov dx, 0x00E9
   164 000000E6 B04C                        mov al, 'L'       ; LFB有効
   165 000000E8 EE                          out dx, al
   166 000000E9 EB10                        jmp .check_done
   167                                  
   168                                  .vbe_not_enabled:
   169 000000EB 66BAE900                    mov dx, 0x00E9
   170 000000EF B056                        mov al, 'V'       ; VBE自体が無効
   171 000000F1 EE                          out dx, al
   172 000000F2 EB07                        jmp .check_done
   173                                  
   174                                  .lfb_not_enabled:
   175 000000F4 66BAE900                    mov dx, 0x00E9
   176 000000F8 B04E                        mov al, 'N'       ; VBE有効、LFB無効
   177                                  
   178 000000FA EE                          out dx, al
   179                                  
   180                                  .check_done:
   181                                      ;;;;;;;;;;;;;;;;
   182                                      
   183                                      ;mov edi, 0xFD000000    ; QEMU/BochsのLFBアドレス
   184 000000FB BF000000E0                  mov edi, 0xE0000000    ; QEMU/BochsのLFBアドレス
   185 00000100 B988130000                  mov ecx, 5000           ; 横幅
   186 00000105 66B81F00                    mov ax, 0x001F         ; RGB565: 青
   187                                  
   188                                  .draw_blue_line:
   189 00000109 668907                      mov word [edi], ax     ; 1ピクセル描画
   190 0000010C 83C702                      add edi, 2             ; 次のピクセルへ
   191 0000010F E2F8                        loop .draw_blue_line
   192                                      
   193 00000111 EBFE                    jmp $
   194                                  
   195                                  ; Reset Vector を FFF0 に置く
   196 00000113 FF<rep FEDDh>           times 0xFFF0-($-$$) db 0xFF
   197                                  
   198                                  ; 存在確認 hexdump -C .mybios.bin | tail
   199                                  reset_vector:
   200 0000FFF0 EA[00000000]00F0            jmp 0xF000:bios_start
   201                                  
   202                                  ; ROMサイズを64KBに揃える
   203 0000FFF7 FF<rep 9h>              times 65536-($-$$) db 0xFF
   204                                  
